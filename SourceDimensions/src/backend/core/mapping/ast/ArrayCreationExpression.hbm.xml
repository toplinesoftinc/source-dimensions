<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="ArrayCreationExpression" extends="Expression" discriminator-value="5">  
	<list name="m_dimExpr" where="F_ROLE=0">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Expression"/>
	</list>
	<join table="T_ARRAY_CREATION_EXPRESSION">
		<key column="F_ID" foreign-key="none"/>
		<property name="m_rank" column="F_RANK"/>
		<many-to-one name="m_initializer" column="F_INITIALIZER" unique="true" foreign-key="none"/>
		<many-to-one name="m_type" column="F_TYPE" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
