<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="BinaryExpression" extends="Expression" discriminator-value="9">   
	<join table="T_BINARY_EXPRESSION">
		<key column="F_ID" foreign-key="none"/>
		<property name="m_kind" column="F_KIND"/>
		<many-to-one name="m_leftOperand" column="F_LEFT_OPERAND" unique="true" foreign-key="none"/>
		<many-to-one name="m_rightOperand" column="F_RIGHT_OPERAND" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
