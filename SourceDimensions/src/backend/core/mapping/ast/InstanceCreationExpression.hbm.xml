<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="InstanceCreationExpression" extends="Expression" discriminator-value="37"> 
	<list name="m_arguments">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Expression"/>
	</list>
	<set name="m_members" where="F_ROLE=1">
		<key column="F_PARENT" foreign-key="none"/>
		<one-to-many class="AbstractMember"/>
	</set>
	<join table="T_INSTANCE_CREATION_EXPESSION">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_type" column="F_TYPE" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
