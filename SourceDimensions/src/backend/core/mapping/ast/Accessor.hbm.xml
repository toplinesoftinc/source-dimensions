<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="Accessor" extends="AstNode" discriminator-value="2">
	<set name="m_modifiers" where="T_ROLE=0">
		<key column="F_PARENT" foreign-key="none"/>
		<one-to-many class="Modifier"/>		
	</set>
	<set name="m_attributes" where="T_ROLE=1">
		<key column="F_PARENT" foreign-key="none"/>
		<one-to-many class="AttributeBlock"/>
	</set>
	<join table="T_ACCESSOR">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_block" column="F_BLOCK" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
