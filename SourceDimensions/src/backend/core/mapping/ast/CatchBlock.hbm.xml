<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="CatchBlock" extends="AstNode" discriminator-value="11">
	<join table="T_CATCH_BLOCK">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_parameter" column="F_PARAMETER" unique="true" foreign-key="none"/>
		<many-to-one name="m_catchBlock" column="F_CATCH_BLOCK" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
