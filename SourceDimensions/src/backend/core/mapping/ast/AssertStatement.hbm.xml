<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="AssertStatement" extends="EmbeddedStatement" discriminator-value="8">
	<join table="T_ASSERT_STATEMENT">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_evalExpr" column="F_EVAL_EXPR" unique="true" foreign-key="none"/>
		<many-to-one name="m_msgDetailExpr" column="F_MSG_DETAIL_EXPR" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
