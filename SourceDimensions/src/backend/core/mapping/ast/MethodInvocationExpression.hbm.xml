<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="MethodInvocationExpression" extends="Expression" discriminator-value="48">  
	<list name="m_arguments" where="F_ROLE=0">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Expression"/>
	</list>
	<list name="m_argList" where="F_ROLE=1">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Expression"/>
	</list>
	<list name="m_typeArguments" where="F_ROLE=2">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="TypeArgument"/>
	</list>
	<join table="T_METHOD_INVOCATION_EXPRESSION">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_methodRef" column="F_METHOD_REF" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
