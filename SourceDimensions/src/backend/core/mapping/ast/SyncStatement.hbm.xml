<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="SyncStatement" extends="EmbeddedStatement" discriminator-value="60"> 
	<join table="T_SYNC_STATEMENT">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_lockExpr" column="F_LOCK_EXPR" unique="true" foreign-key="none"/>
		<many-to-one name="m_statement" column="F_STATEMENT" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
