<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="FixedSizeBufDeclarator" extends="AstNode" discriminator-value="27">
	<join table="T_FIXED_SIZE_BUF_DECLARATOR">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_expression" column="F_EXPRESSION" unique="true" foreign-key="none"/>
		<property name="m_name" length="256" column="F_NAME"/>
	</join>
    </subclass>

</hibernate-mapping>
