<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="LabelStatement" extends="EmbeddedStatement" discriminator-value="39">  
	<join table="T_LABEL_STATEMENT">
		<key column="F_ID" foreign-key="none"/>
		<property name="m_label" length="256" column="F_LABEL"/>
		<many-to-one name="m_statement" column="F_STATEMENT" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
