<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="TryStatement" extends="EmbeddedStatement" discriminator-value="61"> 
	<list name="m_catchSet" where="T_ROLE=0">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="CatchBlock"/>
	</list>
	<join table="T_TRY_STATEMENT">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_tryBlock" column="F_TRY_BLOCK" unique="true" foreign-key="none"/>
		<many-to-one name="m_generalCatch" column="F_GENERAL_CATCH" unique="true" foreign-key="none"/>
		<many-to-one name="m_finallyBlock" column="F_FINALLY_BLOCK" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
