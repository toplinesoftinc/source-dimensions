<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <class name="AstNode" table="T_AST_NODE" discriminator-value="0">
	<id name="m_id" length="32" column="F_ID">
      		<generator class="uuid.hex"/>
	</id>
	<discriminator type="integer" force="true">                                                  
		<column name="F_CLASS" index="idx_project_class,idx_sourcefile_class"/>
	</discriminator>
	<many-to-one name="m_parent" column="F_PARENT" foreign-key="none"/>
	<many-to-one name="m_project" column="F_PROJECT" foreign-key="none" cascade="none" not-null="true" index="idx_project,idx_project_class"/>
	<many-to-one name="m_file" column="F_FILE" foreign-key="none" cascade="none" index="idx_sourcefile,idx_sourcefile_class"/>
	<property name="m_left" column="F_POS_LEFT"/>
	<property name="m_right" column="F_POS_RIGHT"/>
	<property name="m_role" column="F_ROLE"/>
	<set name="m_children" inverse="true">
		<key foreign-key="none">
			<column name="F_PARENT" index="idx_node_parent"/>
		</key>
		<one-to-many class="AstNode"/>	
	</set>
    </class>

</hibernate-mapping>
