<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="UsingDirective" extends="Directive" discriminator-value="74"> 
	<list name="m_name" table="T_NAME" where="T_ROLE=0">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Name"/>
	</list>
	<join table="T_USING_DIRECTIVE">
		<key column="F_ID" foreign-key="none"/>
		<property name="m_isStatic" column="F_IS_STATIC"/>
		<property name="m_isOnDemand" column="F_IS_ONDEMAND"/>
	</join>
    </subclass>

</hibernate-mapping>
