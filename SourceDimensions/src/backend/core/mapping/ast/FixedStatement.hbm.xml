<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="FixedStatement" extends="EmbeddedStatement" discriminator-value="29"> 
	<set name="m_declarators" where="T_ROLE=2">
		<key column="F_PARENT" foreign-key="none"/>
		<one-to-many class="Declarator"/>
	</set>
	<join table="T_FIXED_STATEMENT">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_type" column="F_TYPE" unique="true" foreign-key="none"/>
		<many-to-one name="m_fixedStatement" column="F_FIXED_STATEMENT" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
