<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="ForStatement" extends="EmbeddedStatement" discriminator-value="31">   
	<list name="m_initExprList" where="F_ROLE=0">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Expression"/>
	</list>
	<list name="m_iteration" where="F_ROLE=1">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Expression"/>
	</list>
	<join table="T_FOR_STATEMENT">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_initVarDecl" column="F_INIT_VAR_DECL" unique="true" foreign-key="none"/>
		<many-to-one name="m_forStmt" column="F_FOR_STMT" unique="true" foreign-key="none"/>
		<many-to-one name="m_condition" column="F_CONDITION" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
