<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="EventMember" extends="Member" discriminator-value="23">
	<list name="m_name" table="T_NAME" where="F_ROLE=2">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Name"/>
	</list>
	<set name="m_declarators" where="F_ROLE=3">
		<key column="F_PARENT" foreign-key="none"/>
		<one-to-many class="Declarator"/>
	</set>
	<join table="T_EVENT_MEMBER">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_addAccessor" column="F_ADD_ACCESSOR" unique="true" foreign-key="none"/>
		<many-to-one name="m_removeAccessor" column="F_REMOVE_ACCESSOR" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
