<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="FunctionalMember" extends="Member" discriminator-value="32">
	<list name="m_funcName" table="T_NAME" where="F_ROLE=2">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Name"/>
	</list>
	<list name="m_parameters" where="F_ROLE=3">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Parameter"/>
	</list>
	<list name="m_typeParams" where="F_ROLE=4">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="TypeParameter"/>
	</list>
	<set name="m_constraints" where="F_ROLE=5">
		<key column="F_PARENT" foreign-key="none"/>
		<one-to-many class="Constraint"/>
	</set>
	<set name="m_throwList" where="F_ROLE=6">
		<key column="F_PARENT" foreign-key="none"/>
		<one-to-many class="Type"/>
	</set>
	<list name="m_constrInit" where="F_ROLE=7">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="MethodInvocationExpression"/>
	</list>

	<join table="T_FUNCTIONAL_MEMBER">
		<key column="F_ID" foreign-key="none"/>
		<property name="m_kind" column="F_KIND"/>
		<many-to-one name="m_block" column="F_BLOCK" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
