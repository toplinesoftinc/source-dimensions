<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="Parameter" extends="AstNode" discriminator-value="50">
	<set name="m_modifiers" where="F_ROLE=0">
		<key column="F_PARENT" foreign-key="none"/>
		<one-to-many class="Modifier"/>		
	</set>
	<set name="m_attributes" where="F_ROLE=1">
		<key column="F_PARENT" foreign-key="none"/>
		<one-to-many class="AttributeBlock"/>
	</set>
	<join table="T_PARAMETER">
		<key column="F_ID" foreign-key="none"/>
		<property name="m_varParam" column="F_VAR_PARAM"/>
		<property name="m_finalParam" column="F_FINAL_PARAM"/>
		<property name="m_kind" column="F_KIND"/>
		<many-to-one name="m_type" column="F_TYPE" unique="true" foreign-key="none"/>
		<property name="m_name" length="256" column="F_NAME"/>
	</join>
    </subclass>

</hibernate-mapping>
