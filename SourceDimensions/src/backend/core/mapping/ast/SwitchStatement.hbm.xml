<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="SwitchStatement" extends="EmbeddedStatement" discriminator-value="59"> 
	<list name="m_sections" where="T_ROLE=0">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="SwitchSection"/>
	</list>
	<join table="T_SWITCH_STATEMENT">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_switchExpr" column="F_SWITCH_EXPR" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
