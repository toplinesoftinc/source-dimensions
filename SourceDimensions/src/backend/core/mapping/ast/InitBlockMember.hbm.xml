<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="InitBlockMember" extends="AbstractMember" discriminator-value="36"> 
	<join table="T_INIT_BLOCK_MEMBER">
		<key column="F_ID" foreign-key="none"/>
		<property name="m_staticBlock" column="F_STATIC_BLOCK"/>
		<many-to-one name="m_block" column="F_BLOCK" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
