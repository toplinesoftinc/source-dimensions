<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">
	
<hibernate-mapping package="com.sourcedimensions.server.ast" default-cascade="save-update" default-access="field">

    <subclass name="IndexerMember" extends="Member" discriminator-value="35">
	<list name="m_name" table="T_NAME" where="F_ROLE=2">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Name"/>
	</list>
	<list name="m_parameters" where="F_ROLE=3">
		<key column="F_PARENT" foreign-key="none"/>
		<list-index column="F_ORDINAL_INDEX"/>
		<one-to-many class="Parameter"/>
	</list>
	<join table="T_INDEXER_MEMBER">
		<key column="F_ID" foreign-key="none"/>
		<many-to-one name="m_interfaceType" column="F_INTERFACE_TYPE" unique="true" foreign-key="none"/>
		<many-to-one name="m_getAccessor" column="F_GET_ACCESSOR" unique="true" foreign-key="none"/>
		<many-to-one name="m_setAccessor" column="F_SET_ACCESSOR" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
