<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.sourcedimensions.server.sys" default-cascade="save-update" default-access="field">

    <subclass name="SourceFile" extends="FileSystemElement" discriminator-value="2">
	<join table="T_SOURCE_FILE">
		<key column="F_ID" foreign-key="none"/>
		<property name="m_binary" column="F_BIN" not-null="true"/>
		<property name="m_fullName" column="F_FULL_NAME" length="1024"/>
		<property name="m_encoding" column="F_ENCODING" length="10" />
		<many-to-one name="m_unit" column="F_UNIT" unique="true" foreign-key="none"/>
	</join>
    </subclass>

</hibernate-mapping>
