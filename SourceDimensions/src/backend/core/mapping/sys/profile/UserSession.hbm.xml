<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.sourcedimensions.server.sys.profile" default-cascade="save-update" default-access="field">

    <class name="UserSession" table="T_USER_SESSION">
        <id name="m_id" length="32" column="F_ID">
            <generator class="uuid.hex"/>
        </id>
	<many-to-one name="m_user" column="F_USER" unique="true"/>
	<property name="m_created" column="F_CREATED"/>
	<property name="m_lastHit" column="F_LAST_HIT"/>
    </class>

</hibernate-mapping>
