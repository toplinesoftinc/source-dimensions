<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="com.sourcedimensions.server.sys.profile" default-cascade="save-update" default-access="field">

    <class name="User" table="T_USER">
        <id name="m_id" length="32" column="F_ID">
            <generator class="uuid.hex"/>
        </id>
        <property name="m_name" length="80" column="F_NAME"/>
        <property name="m_password" length="80" column="F_PASSWORD"/>
        <property name="m_fullName" length="256" column="F_FULL_NAME"/>
	<property name="m_superUser" column="F_SUPERUSER"/>
	<many-to-one name="m_account" column="F_ACCOUNT"/>
    </class>

</hibernate-mapping>
