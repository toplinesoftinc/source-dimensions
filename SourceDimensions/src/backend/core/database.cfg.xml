<?xml version='1.0' encoding='utf-8'?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://hibernate.sourceforge.net/hibernate-configuration-3.0.dtd">

<hibernate-configuration>

    <session-factory>

	<!-- JDBC driver -->
        <property name="connection.driver_class">org.postgresql.Driver</property>

        <!-- JDBC connection pool (use the built-in) -->
        <property name="connection.pool_size">20</property>

        <!-- SQL dialect -->
        <property name="dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- Enable Hibernate's automatic session context management -->
        <property name="current_session_context_class">thread</property>

	<property name="hibernate.jdbc.batch_size">30</property>

        <!-- Disable the second-level cache  -->
        <property name="cache.provider_class">org.hibernate.cache.NoCacheProvider</property>

        <!-- Echo all executed SQL to stdout -->
        <property name="show_sql">true</property>
	<property name="format_sql">true</property>

        <!-- Update schema as necessary -->
        <property name="hbm2ddl.auto">update</property>

	<mapping resource="mapping/sys/Project.hbm.xml"/>
        <mapping resource="mapping/sys/FileSystemElement.hbm.xml"/>
        <mapping resource="mapping/sys/Folder.hbm.xml"/>
        <mapping resource="mapping/sys/SourceFile.hbm.xml"/>

	<mapping resource="mapping/ast/AbstractMember.hbm.xml"/>
	<mapping resource="mapping/ast/AbstractStatement.hbm.xml"/>
